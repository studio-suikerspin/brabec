{
  "format": "custom",
  "id": "settings",
  "label": "Settings",
  "repeatable": false,
  "status": true,
  "json": {
    "Main": {
      "site_title": {
        "type": "Text",
        "config": {
          "label": "Site Title",
          "placeholder": ""
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": ""
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta Image",
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "thumbnails": []
        }
      },
      "navigation": {
        "type": "Link",
        "config": {
          "label": "Navigation",
          "placeholder": "",
          "select": null,
          "allowTargetBlank": true,
          "allowText": true,
          "repeat": true,
          "variants": ["Link", "Button"]
        }
      },
      "agenda": {
        "type": "Group",
        "config": {
          "label": "Agenda",
          "repeat": false,
          "fields": {
            "spots_available": {
              "type": "Boolean",
              "config": {
                "label": "Plekken beschikbaar?",
                "placeholder_false": "Nee",
                "placeholder_true": "Ja",
                "default_value": true
              }
            },
            "spots_available_count": {
              "type": "Number",
              "config": {
                "label": "Aantal beschikbare plekken",
                "placeholder": "2"
              }
            }
          }
        }
      }
    }
  }
}
