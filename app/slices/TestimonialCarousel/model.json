{
  "type": "SharedSlice",
  "id": "testimonial_carousel",
  "name": "TestimonialCarousel",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "description": "Default carousel with main heading, subheading, horizontal testimonial navigation, and faces for navigation.",
      "version": "initial",
      "imageUrl": "",
      "docURL": "...",
      "primary": {
        "subtitle": {
          "type": "StructuredText",
          "config": {
            "single": "paragraph",
            "label": "Subtitle"
          }
        },
        "title": {
          "type": "StructuredText",
          "config": {
            "label": "Title",
            "placeholder": "",
            "allowTargetBlank": true,
            "single": "heading2"
          }
        },
        "testimonials": {
          "type": "Group",
          "config": {
            "label": "Testimonials",
            "fields": {
              "text": {
                "type": "StructuredText",
                "config": {
                  "label": "Testimonial Text",
                  "placeholder": "",
                  "allowTargetBlank": true,
                  "single": "paragraph,strong,em,hyperlink"
                }
              },
              "author_name": {
                "type": "Text",
                "config": {
                  "label": "Author Name"
                }
              },
              "author_role": {
                "type": "Text",
                "config": {
                  "label": "Author Role"
                }
              },
              "author_avatar": {
                "type": "Image",
                "config": {
                  "label": "Author Avatar"
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}